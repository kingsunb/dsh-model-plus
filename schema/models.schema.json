{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsh-model-plus model catalog",
  "type": "object",
  "required": ["version", "models"],
  "properties": {
    "version": { "type": "integer", "minimum": 2 },
    "name": { "type": "string" },
    "updatedAt": { "type": "string" },
    "description": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "idPattern": { "type": "string" },
          "name": { "type": "string" },
          "thinkingFormat": { "type": "string" },
          "vision": { "type": "boolean" },
          "contextWindow": { "type": "integer", "minimum": 1 },
          "maxTokens": { "type": "integer", "minimum": 1 },
          "input": {
            "type": "array",
            "items": { "type": "string", "enum": ["text", "image"] },
            "uniqueItems": true
          },
          "reasoningEfforts": {
            "oneOf": [
              { "const": false },
              { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
            ]
          }
        }
      }
    }
  }
}
